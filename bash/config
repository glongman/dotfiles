export EDITOR="vim"
eval "$(rbenv init -)"

function parse_git_branch {
  ref=$(git symbolic-ref HEAD 2> /dev/null) || return
  echo "("${ref#refs/heads/}")"
}

RED="\[\033[0;31m\]"
YELLOW="\[\033[0;33m\]"
GREEN="\[\033[0;32m\]"
WHITE="\[\033[0;37m\]"
PS1="$RED\$(date +%H:%M) \w$YELLOW \$(parse_git_branch)$WHITE\$ "

export BASH_SILENCE_DEPRECATION_WARNING=1

export GOPATH=$HOME/Projects/GO
export ZEUSSOCK=$HOME/tmp/.zeus.sock
export OBJC_DISABLE_INITIALIZE_FORK_SAFETY=YES 

export HOMEBREW_NO_ANALYTICS=1
export HOMEBREW_NO_INSTALLED_DEPENDENTS_CHECK=1 
export HOMEBREW_NO_INSTALL_CLEANUP=1
export HOMEBREW_NO_INSTALL_UPGRADE=1


export RUBY_DEBUG_ENABLE=1

export COVERBAND_DISABLE_AUTO_START=yes
export PATH="/opt/homebrew/opt/mysql@5.7/bin:$PATH"

export DISABLE_BOOTSNAP=true

export DISABLE_DATABASE_ENVIRONMENT_CHECK=1
shadowme() {
  local SOURCE_DIR="$HOME/dev/hw-admin"
  local ALLOWED_ROOT="$HOME/Projects"

  # 1. SCOPE CHECK: Silent exit if NOT under ~/Projects
  if [[ "$PWD" != "$ALLOWED_ROOT" && "$PWD" != "$ALLOWED_ROOT"/* ]]; then
    return 0
  fi

  # 2. SOURCE CHECK: Silent exit if inside main checkout
  if [[ "$PWD" -ef "$SOURCE_DIR" ]]; then
    return 0
  fi

  # 3. SAFETY CHECK: Is there a REAL directory here?
  # If .shadowenv.d exists and is NOT a symlink, we assume it contains
  # custom work. We stop immediately to avoid deleting it.
  if [[ -d ".shadowenv.d" && ! -L ".shadowenv.d" ]]; then
    echo "⚠️  Skipping shadowme: Found a real .shadowenv.d directory."
    return 0
  fi

  # 4. IDEMPOTENCY: Is it already linked correctly?
  if [[ -L ".shadowenv.d" ]] && [[ "$(readlink .shadowenv.d)" == "$SOURCE_DIR/.shadowenv.d" ]]; then
    # Optional: ensure it's trusted, but keep it silent
    shadowenv trust > /dev/null 2>&1
    return 0
  fi

  # 5. EXECUTION: Clean (safe now), Link, Trust
  rm -rf .shadowenv.d
  ln -s "$SOURCE_DIR/.shadowenv.d" .shadowenv.d
  shadowenv trust
}
shadowme
# rx_workflows configuration
source "$HOME/.config/rx_workflows/init.sh"
